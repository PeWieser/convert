{
  "name": "wandler",
  "private": true,
  "version": "1.0.0",
  "description": "Wandler – Videos und Musik konvertieren. Web-App (WebCodecs) und Windows-App (Electron + FFmpeg).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/job.test.ts test/safety.test.ts --bundle --platform=node --format=cjs --outdir=.tmp/tests --out-extension:.js=.cjs --log-level=error && node .tmp/tests/job.test.cjs && node --test .tmp/tests/safety.test.cjs",
    "desktop:build": "npm run build && npm --prefix desktop run build",
    "desktop:start": "npm --prefix desktop start",
    "test:ui": "playwright test",
    "test:ffmpeg": "esbuild test/ffmpeg.integration.ts --bundle --platform=node --format=cjs --outfile=.tmp/ffmpeg.integration.cjs --log-level=error && node --test .tmp/ffmpeg.integration.cjs"
  },
  "dependencies": {
    "@mediabunny/aac-encoder": "^1.61.3",
    "@mediabunny/flac-encoder": "^1.61.3",
    "@mediabunny/mp3-encoder": "^1.61.3",
    "clsx": "2.1.1",
    "lucide-react": "^1.55.0",
    "mediabunny": "^1.61.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "^0.28.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "zod": "^4.3.6"
  }
}
